<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Primeira Lei de Ohm (V = R x I)"
        android:textSize="20sp"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/editTensao"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Tensão (V) em Volts"
        android:inputType="numberDecimal" />

    <EditText
        android:id="@+id/editResistencia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Resistência (R) em Ohms"
        android:inputType="numberDecimal" />

    <EditText
        android:id="@+id/editCorrente"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Corrente (I) em Ampères"
        android:inputType="numberDecimal" />

    <Button
        android:id="@+id/btnCalcular"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Calcular"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/textResultado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Resultado: "
        android:textSize="22sp"
        android:layout_marginTop="24dp" />

</LinearLayout>
